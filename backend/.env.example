# Para rodar diretamente no seu computador:
DATABASE_URL=mysql+pymysql://faceclass:faceclass@localhost:3306/face_class

# Troque por uma frase longa e secreta antes de apresentar ou publicar.
JWT_SECRET=troque-esta-chave-por-uma-frase-longa-e-secreta
JWT_EXPIRE_MINUTES=480

# Modo de apresentação. Em produção, deixe false e integre um serviço facial.
DEMO_MODE=true
DEMO_FACE_TOKEN=faceclass-demo-ok
ALLOW_BOOTSTRAP_ADMIN=true

# Deixe false quando o MySQL já tiver recebido o arquivo database/01_schema_faceclass.sql.
CREATE_TABLES_ON_START=false

